# =============================================================================
# WorkforceIQ environment configuration (EXAMPLE — contains no real secrets)
# -----------------------------------------------------------------------------
# Copy to `.env` in the repository root and fill in real values:
#     Copy-Item .env.example .env
# `.env` is git-ignored. Never commit real credentials.
# Backend variables use the WFIQ_ prefix; frontend variables use VITE_.
# =============================================================================

# --- Application -------------------------------------------------------------
# development | test | production
WFIQ_ENV=development
# DEBUG | INFO | WARNING | ERROR
WFIQ_LOG_LEVEL=INFO
# json (structured, one JSON object per line) | console (human readable)
WFIQ_LOG_FORMAT=json
WFIQ_API_PREFIX=/api/v1
# Comma-separated list of allowed browser origins (Vite dev server by default)
WFIQ_CORS_ORIGINS=http://localhost:5173

# --- Database ----------------------------------------------------------------------
# sqlite (default; no installation needed) | postgresql
WFIQ_DB_BACKEND=sqlite
# SQLite files (relative to backend/). Tests never use these: they use temporary copies.
WFIQ_SQLITE_PATH=../data/db/workforceiq.sqlite3
WFIQ_SQLITE_TEST_PATH=../data/db/workforceiq_test.sqlite3

# --- PostgreSQL (only used when WFIQ_DB_BACKEND=postgresql) --------------------------
WFIQ_DB_HOST=localhost
WFIQ_DB_PORT=5432
WFIQ_DB_NAME=workforceiq
WFIQ_DB_USER=workforceiq_app
# Required only for PostgreSQL. Set the password you chose when creating the role.
WFIQ_DB_PASSWORD=
WFIQ_DB_ECHO=false
# Separate database used by integration tests (it is wiped and re-migrated).
WFIQ_TEST_DB_NAME=workforceiq_test

# --- Business rules & synthetic data ----------------------------------------
# Paths are relative to the backend/ folder.
WFIQ_RULES_FILE=config/business_rules.toml
# starter | full
WFIQ_GENERATOR_MODE=starter
WFIQ_DATA_OUTPUT_DIR=../data/generated

# --- Frontend (read by Vite in Phase 6) ---------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
